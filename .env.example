# --- Database ---
# Local dev uses the postgres service from docker-compose.yml
DATABASE_URL=postgresql://mdtp:mdtp@localhost:5433/horizon_journal_google_local?schema=public

# --- Auth ---
# Generate with: openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=change-me-generate-a-real-secret
APP_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PUBLIC_SUPPORT_EMAIL=

# --- App ---
# private attachments storage (gitignored, never served statically)
UPLOAD_DIR=./uploads

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
# --- AI Journal Insights (optional, server only) ---
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
