# --- Database ---
# Local dev uses the postgres service from docker-compose.yml
DATABASE_URL=postgresql://mdtp:mdtp@localhost:5433/mdtp?schema=public

# --- Auth ---
# Generate with: openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=change-me-generate-a-real-secret

# --- App ---
# private attachments storage (gitignored, never served statically)
UPLOAD_DIR=./uploads
# optional base currency for display conversion (USD is the ledger base)
NEXT_PUBLIC_APP_NAME=MDTP
